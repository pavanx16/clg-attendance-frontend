<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Dashboard</title>


<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f7fb;
        color: #172033;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 20px 50px;
    }

    .header {
        margin-bottom: 24px;
    }

    .header h1 {
        margin: 0 0 8px;
        font-size: 32px;
    }

    .header p {
        margin: 0;
        color: #687386;
        font-size: 15px;
    }

    .search-box {
        margin-bottom: 24px;
    }

    .search-box input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #dfe4ec;
        border-radius: 10px;
        background: white;
        font-size: 15px;
        outline: none;
    }

    .search-box input:focus {
        border-color: #7b879c;
    }

    .user-card {
        background: white;
        border: 1px solid #e4e8ef;
        border-radius: 16px;
        margin-bottom: 28px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    }

    .user-header {
        padding: 24px;
        border-bottom: 1px solid #edf0f4;
    }

    .user-name {
        margin: 0 0 8px;
        font-size: 23px;
    }

    .user-email {
        margin: 0;
        color: #687386;
        font-size: 14px;
    }

    .updated {
        margin-top: 10px;
        color: #8992a3;
        font-size: 13px;
    }

    .section {
        padding: 24px;
    }

    .section-title {
        margin: 0 0 16px;
        font-size: 18px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
    }

    .stat {
        padding: 18px;
        background: #f8f9fc;
        border: 1px solid #edf0f4;
        border-radius: 12px;
    }

    .stat-label {
        display: block;
        color: #737d8f;
        font-size: 13px;
        margin-bottom: 9px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
    }

    .table-wrapper {
        overflow-x: auto;
        border: 1px solid #e6e9ef;
        border-radius: 12px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 650px;
    }

    th {
        background: #f8f9fc;
        color: #596477;
        font-size: 13px;
        text-align: left;
        padding: 14px 16px;
        border-bottom: 1px solid #e6e9ef;
    }

    td {
        padding: 15px 16px;
        border-bottom: 1px solid #edf0f4;
        font-size: 14px;
    }

    tr:last-child td {
        border-bottom: 0;
    }

    .subject {
        font-weight: 600;
    }

    .percentage {
        font-weight: 700;
    }

    .no-results {
        display: none;
        text-align: center;
        padding: 40px;
        color: #737d8f;
        background: white;
        border: 1px solid #e4e8ef;
        border-radius: 16px;
    }

    .empty {
        background: white;
        border: 1px solid #e4e8ef;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
    }

    .empty h2 {
        margin: 0 0 8px;
    }

    .empty p {
        margin: 0;
        color: #737d8f;
    }

    @media (max-width: 900px) {
        .stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .container {
            padding: 22px 14px 40px;
        }

        .header h1 {
            font-size: 26px;
        }

        .user-header,
        .section {
            padding: 18px;
        }

        .stats {
            grid-template-columns: 1fr;
        }

        .stat-value {
            font-size: 22px;
        }
    }
</style>


</head>
<body>

<div class="container">

    <div class="header">
        <h1>Attendance Dashboard</h1>

        <p>
            Attendance information for {{ users|length }} user(s)
        </p>
    </div>


    {% if users %}

        <div class="search-box">
            <input
                type="text"
                id="userSearch"
                placeholder="Search users by username or email..."
                autocomplete="off"
            >
        </div>


        <div id="usersContainer">

            {% for user in users %}

                {% set stats = user.statistics|default({}) %}

                <div
                    class="user-card"
                    data-search="{{ user.username }} {{ user.email }}"
                >

                    <div class="user-header">

                        <h2 class="user-name">
                            {{ user.username }}
                        </h2>

                        <p class="user-email">
                            {{ user.email }}
                        </p>

                        {% if user.scraped_at %}
                            <div class="updated">
                                Last updated:
                                <span
                                    class="scraped-time"
                                    data-time="{{ user.scraped_at.isoformat() }}"
                                >
                                    {{ user.scraped_at.strftime("%d %b %Y, %I:%M %p") }}
                                </span>
                            </div>
                        {% else %}
                            <div class="updated">
                                Last updated: Never
                            </div>
                        {% endif %}

                    </div>


                    <div class="section">

                        <h3 class="section-title">
                            Statistics
                        </h3>

                        <div class="stats">

                            <div class="stat">
                                <span class="stat-label">
                                    Total Attendances
                                </span>

                                <span class="stat-value">
                                    {{ stats.total_attendances|default(0) }}
                                </span>
                            </div>


                            <div class="stat">
                                <span class="stat-label">
                                    Total Present
                                </span>

                                <span class="stat-value">
                                    {{ stats.total_present|default(0) }}
                                </span>
                            </div>


                            <div class="stat">
                                <span class="stat-label">
                                    Overall Percentage
                                </span>

                                <span class="stat-value">
                                    {{ stats.overall_percentage|default(0) }}%
                                </span>
                            </div>


                            <div class="stat">
                                <span class="stat-label">
                                    Average Percentage
                                </span>

                                <span class="stat-value">
                                    {{ stats.avg_percentage|default(0) }}%
                                </span>
                            </div>


                            <div class="stat">
                                <span class="stat-label">
                                    Subjects
                                </span>

                                <span class="stat-value">
                                    {{ stats.subjects_count|default(0) }}
                                </span>
                            </div>

                        </div>

                    </div>


                    <div class="section">

                        <h3 class="section-title">
                            Subject Attendance
                        </h3>

                        {% if user.subjects %}

                            <div class="table-wrapper">

                                <table>

                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Subject</th>
                                            <th>Total Attendances</th>
                                            <th>Present</th>
                                            <th>Percentage</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        {% for subject in user.subjects %}

                                            <tr>

                                                <td>
                                                    {{ loop.index }}
                                                </td>

                                                <td class="subject">
                                                    {{ subject.subject }}
                                                </td>

                                                <td>
                                                    {{ subject.total_attendances }}
                                                </td>

                                                <td>
                                                    {{ subject.total_present }}
                                                </td>

                                                <td class="percentage">
                                                    {{ subject.percentage }}%
                                                </td>

                                            </tr>

                                        {% endfor %}

                                    </tbody>

                                </table>

                            </div>

                        {% else %}

                            <p>
                                No subject attendance data available.
                            </p>

                        {% endif %}

                    </div>

                </div>

            {% endfor %}

        </div>


        <div id="noResults" class="no-results">
            <strong>No users found</strong>
            <p>
                Try searching with a different username or email.
            </p>
        </div>


    {% else %}

        <div class="empty">

            <h2>
                No Attendance Data
            </h2>

            <p>
                Attendance information will appear here once data is available.
            </p>

        </div>

    {% endif %}

</div>


<script>

    /* =========================
       USER SEARCH
       ========================= */

    const searchInput = document.getElementById("userSearch");
    const userCards = document.querySelectorAll(".user-card");
    const noResults = document.getElementById("noResults");

    if (searchInput) {

        searchInput.addEventListener("input", function () {

            const searchText = this.value
                .toLowerCase()
                .trim();

            let visibleUsers = 0;

            userCards.forEach(function (card) {

                const userData = card
                    .getAttribute("data-search")
                    .toLowerCase();

                if (userData.includes(searchText)) {

                    card.style.display = "";
                    visibleUsers++;

                } else {

                    card.style.display = "none";

                }

            });


            if (visibleUsers === 0 && searchText !== "") {

                noResults.style.display = "block";

            } else {

                noResults.style.display = "none";

            }

        });

    }


    /* =========================
       CONVERT UTC TIME → IST
       ========================= */

    function updateTimes() {

        const timeElements =
            document.querySelectorAll(".scraped-time");


        timeElements.forEach(function (element) {

            const utcTime =
                element.getAttribute("data-time");


            if (!utcTime) {
                return;
            }


            const date = new Date(utcTime);


            if (isNaN(date.getTime())) {
                return;
            }


            element.textContent =
                date.toLocaleString("en-IN", {

                    timeZone: "Asia/Kolkata",

                    day: "2-digit",

                    month: "short",

                    year: "numeric",

                    hour: "2-digit",

                    minute: "2-digit",

                    second: "2-digit",

                    hour12: true

                });

        });

    }


    /*
     * Run immediately when page loads.
     */
    updateTimes();


    /* =========================
       AUTO REFRESH
       ========================= */

    /*
     * Reload the page every 60 seconds.
     *
     * This fetches fresh data from MongoDB
     * through FastAPI/Jinja.
     */

    setInterval(function () {

        location.reload();

    }, 60000);

</script>

</body>
</html>
